<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📡 MySafe — Video & GPS par WiFi/SMS"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etNumeroCible"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="📱 Numero du telephone cible"
        android:inputType="phone"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="#E3F2FD"
        android:layout_marginBottom="10dp"/>

    <!-- 🎥 ZONE VIDEO — ICI S'AFFICHE LE FLUX -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎥 FLUX VIDEO"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#6A00C9"
        android:layout_marginBottom="4dp"/>

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#000000"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvStatut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ Pret — Sur le meme WiFi !"
        android:textSize="13sp"
        android:padding="10dp"
        android:background="#E8F5E9"
        android:textColor="#006633"
        android:layout_marginBottom="10dp"/>

    <!-- 📲 BOUTONS CIBLE (active la caméra/micro ICI) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📲 SUR CE TELEPHONE :"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#E65100"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnStartStream"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="📷 ACTIVER CAMERA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#E65100"
            android:textColor="#FFFFFF"/>

        <View android:layout_width="6dp" android:layout_height="1dp"/>

        <Button
            android:id="@+id/btnStopStream"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="⏹️ ARRETER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#CC0000"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- 📱 BOUTONS CLIENT (voit le flux) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 SUR TON TELEPHONE :"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#6A00C9"
        android:layout_marginBottom="6dp"/>

    <Button
        android:id="@+id/btnConnectStream"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="👁️ VOIR LE FLUX (IP du telephone cible)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#6A00C9"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etIpCible"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="🌐 IP du telephone cible (ex: 192.168.1.42)"
        android:inputType="textEmailAddress"
        android:textSize="14sp"
        android:padding="10dp"
        android:background="#F3E5F5"
        android:layout_marginBottom="10dp"/>

    <!-- 📍 GPS PAR SMS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        android:gravity="center"
        android:textColor="#CCCCCC"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnPosition"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="📍 POSITION"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#6A00C9"
            android:textColor="#FFFFFF"/>

        <View android:layout_width="6dp" android:layout_height="1dp"/>

        <Button
            android:id="@+id/btnSuivi"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="📡 SUIVI"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#009933"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvJournal"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="Journal des evenements..."
        android:textSize="11sp"
        android:padding="8dp"
        android:background="#F9F9F9"
        android:scrollbars="vertical"/>

</LinearLayout>
