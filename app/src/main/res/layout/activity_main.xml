<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MySafe — 📹🔊 Caméra + Audio à distance"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ Appairage unique — Connexion automatique depuis N'IMPORTE OÙ"
            android:textSize="13sp"
            android:textColor="#444444"
            android:layout_marginBottom="16dp"/>

        <!-- 🔒 SECTION APPAIRAGE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 APPAIRAGE DES 2 TÉLÉPHONES"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#6A00C9"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvMonCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ Initialisation..."
            android:textSize="14sp"
            android:textColor="#006633"
            android:padding="10dp"
            android:background="#E8F5E9"
            android:layout_marginBottom="8dp"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Sur l'autre téléphone, entre ce code :"
            android:textSize="13sp"
            android:textColor="#555555"/>

        <EditText
            android:id="@+id/etCodePartenaire"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Colle le code de l'autre téléphone ici"
            android:textSize="14sp"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnApparier"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🔗 APPARIER LES DEUX TÉLÉPHONES"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#6A00C9"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvAppairageStatut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❌ Non appairé"
            android:textSize="13sp"
            android:textColor="#CC0000"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- 📹 SECTION STREAMING CAMÉRA + AUDIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📹🔊 FLUX CAMÉRA + MICRO"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#006633"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 TÉLÉPHONE CIBLE → Cliquez 'ACTIVER LA CAMÉRA'\n📲 TON TÉLÉPHONE → Cliquez 'VOIR & ENTENDRE'"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:background="#006633"
            android:layout_marginBottom="12dp"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnStartCamera"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="📹 ACTIVER LA CAMÉRA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#006633"
                android:textColor="#FFFFFF"/>

            <View android:layout_width="10dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnViewStream"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="📺 VOIR & ENTENDRE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#6A00C9"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnStopAll"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="⏹️ ARRÊTER TOUT"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#CC0000"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvStreamStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Prêt — Appairez les 2 téléphones d'abord"
            android:textSize="13sp"
            android:textColor="#006633"
            android:gravity="center"
            android:padding="10dp"
            android:background="#E8F5E9"
            android:layout_marginBottom="16dp"/>

        <!-- 📍 SECTION GPS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 SUIVI GPS"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#6A00C9"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etTargetNumber"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="📞 Numéro du téléphone à suivre"
            android:textSize="16sp"
            android:inputType="phone"
            android:textColor="#000000"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnMyPosition"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="🟢 MA POSITION"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#6A00C9"
                android:textColor="#FFFFFF"/>

            <View android:layout_width="10dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnGetHisPosition"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="🔴 SA POSITION"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#6A00C9"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnDemarrer"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="▶️ SUIVI CONTINU"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#009933"
                android:textColor="#FFFFFF"/>

            <View android:layout_width="10dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnStopTracking"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="⏹️ STOP"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#CC0000"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPositions"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="📋 Journal des événements..."
            android:textSize="12sp"
            android:textColor="#000000"
            android:background="#F5F5F5"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:scrollbars="vertical"
            android:maxLines="5"/>

    </LinearLayout>
</ScrollView>
