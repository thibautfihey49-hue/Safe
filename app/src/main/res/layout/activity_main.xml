<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#F5F5F5">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📍 MySafe — GPS Tracking Invisible" android:textSize="20sp"
        android:textStyle="bold" android:gravity="center" android:padding="16dp"/>
    <EditText android:id="@+id/etTargetNumber" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="📞 Numéro de téléphone cible"
        android:inputType="phone" android:layout_marginBottom="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gap="8dp">
        <Button android:id="@+id/btnFloatingMap" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="📌 Carte flottante"/>
        <Button android:id="@+id/btnClearHistory" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🗑️ Effacer"/>
    </LinearLayout>
    <org.osmdroid.views.MapView android:id="@+id/mapView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"/>
</LinearLayout>
