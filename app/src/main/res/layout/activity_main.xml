<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MySafe GPS"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suivi GPS discret par SMS"
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etTargetNumber"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="📞 Numéro du téléphone à suivre"
            android:textSize="18sp"
            android:inputType="phone"
            android:textColor="#000000"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnMyPosition"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="🟢 MA POSITION"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#6A00C9"
                android:textColor="#FFFFFF"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnGetHisPosition"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="🔴 SA POSITION"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#6A00C9"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnDemarrer"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="▶️ SUIVI"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#6A00C9"
                android:textColor="#FFFFFF"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="⏹️ STOP"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#6A00C9"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnFloatingMap"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="🗺️ CARTE FLOTTANTE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#6A00C9"
                android:textColor="#FFFFFF"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="🗑️ EFFACER"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#6A00C9"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPositions"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="📋 Journal des événements..."
            android:textSize="14sp"
            android:textColor="#000000"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:scrollbars="vertical"
            android:maxLines="8"/>

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎥 STREAMING CAMÉRA"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#006633"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Caméra :"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnCamFront"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="👤 AVANT"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#444444"
                android:textColor="#FFFFFF"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnCamBack"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="📷 ARRIÈRE"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#006633"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔊 Son / Micro :"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnMicToggle"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="🎤 MICRO: OFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#444444"
                android:textColor="#FFFFFF"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnSpeakToggle"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="🔊 SON: OFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#444444"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnStartStream"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="▶️ DÉMARRER LE STREAM"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#009933"
                android:textColor="#FFFFFF"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnStopStream"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="⏹️ ARRÊTER"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#CC0000"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📹 Aperçu caméra :"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <TextureView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#000000"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvStreamStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Prêt — choisis caméra et clique DÉMARRER"
            android:textSize="14sp"
            android:textColor="#006633"
            android:gravity="center"
            android:padding="12dp"
            android:background="#E8F5E9"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>
