<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 MySafe — Controle par SMS"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etNumeroCible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="📱 Numero du telephone cible"
        android:inputType="phone"
        android:textSize="18sp"
        android:padding="14dp"
        android:background="#E8F5E9"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnPosition"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="📍 POSITION"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#6A00C9"
            android:textColor="#FFFFFF"/>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp"/>

        <Button
            android:id="@+id/btnSuivi"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="📡 SUIVI"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#009933"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="⏹️ ARRETER TOUT"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#CC0000"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📲 Commandes par SMS (envoyez ces messages au telephone cible) :"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="!!POSITION → Demander la position\n!!DEMARRER → Suivi continu\n!!STOP → Arreter tout\n!!CAMERA → Activer la caméra\n!!AUDIO → Activer le micro\n!!CAMERA,STOP → Arreter caméra/micro"
        android:textSize="11sp"
        android:padding="10dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvStatut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ Systeme pret — Entre un numero !"
        android:textSize="13sp"
        android:padding="10dp"
        android:background="#E8F5E9"
        android:layout_marginBottom="12dp"/>

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📜 Journal :"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvJournal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="Evenements..."
        android:textSize="11sp"
        android:padding="8dp"
        android:background="#F9F9F9"
        android:scrollbars="vertical"/>

</LinearLayout>
